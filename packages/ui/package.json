{
  "name": "@jcdecor/ui",
  "version": "0.1.8",
  "description": "Design System JC Decor — tema, tokens e componentes React sobre Mantine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JC-Decor/design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/JC-Decor/design-system#readme",
  "bugs": {
    "url": "https://github.com/JC-Decor/design-system/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "jcdecor",
    "design-system",
    "mantine",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "@mantine/charts": ">=9.0.0",
    "@mantine/core": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "@mantine/notifications": ">=9.0.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "recharts": ">=3.2.1"
  },
  "peerDependenciesMeta": {
    "@mantine/charts": {
      "optional": true
    },
    "@mantine/notifications": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@mantine/charts": "^9.6.3",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1"
  }
}
