{
  "name": "jcdecor-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w docs",
    "dev:connect": "npm run dev -w connect-docs",
    "build": "npm run build:ui && npm run build:vue && npm run build:connect && npm run build -w docs && npm run build -w connect-docs",
    "build:ui": "npm run build -w @jcdecor/ui",
    "build:vue": "npm run build -w @jcdecor/vue",
    "build:connect": "npm run build -w @jcdecor/connect-ui",
    "test": "npm run test -w @jcdecor/ui && npm run test -w @jcdecor/vue && npm run test -w @jcdecor/connect-ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "changeset": "changeset",
    "release": "npm run build:ui && npm run build:vue && npm run build:connect && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
